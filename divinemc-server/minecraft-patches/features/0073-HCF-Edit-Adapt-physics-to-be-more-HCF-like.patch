Subject: [PATCH] HCF Edit - Adapt physics to be more HCF-like


diff --git a/net/minecraft/world/entity/projectile/FishingHook.java b/net/minecraft/world/entity/projectile/FishingHook.java
index 5f3abbe943be394e9cb987945a238208940b5015..0306af61504ba847ff3c935db201e733a4ce564d 100755
--- a/net/minecraft/world/entity/projectile/FishingHook.java
+++ b/net/minecraft/world/entity/projectile/FishingHook.java
@@ -295,6 +295,14 @@ public class FishingHook extends Projectile {
     @Override
     protected void onHitEntity(EntityHitResult result) {
         super.onHitEntity(result);
+
+        // HCF Edit - KNOCKBACK YESYES
+        Entity entity = result.getEntity();
+        if (entity instanceof net.minecraft.server.level.ServerPlayer serverPlayer) {
+            entity.hurt(this.damageSources().thrown(this, this.getOwner()), 0.0000001F);
+            serverPlayer.knockback(0.4000000059604645D, this.getX() - entity.getX(), this.getZ() - entity.getZ());
+        }
+
         if (!this.level().isClientSide) {
             this.setHookedEntity(result.getEntity());
         }
diff --git a/net/minecraft/world/entity/projectile/ThrownSplashPotion.java b/net/minecraft/world/entity/projectile/ThrownSplashPotion.java
index 5c4069358398b1d1a3d17f22e254071b6d2f22e9..5a67347489df6beb1af97c9e73cd97155bd8ffdf 100755
--- a/net/minecraft/world/entity/projectile/ThrownSplashPotion.java
+++ b/net/minecraft/world/entity/projectile/ThrownSplashPotion.java
@@ -16,6 +16,9 @@ import net.minecraft.world.item.alchemy.PotionContents;
 import net.minecraft.world.level.Level;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.HitResult;
+import net.minecraft.world.phys.Vec3;
+
+
 
 public class ThrownSplashPotion extends AbstractThrownPotion {
     public ThrownSplashPotion(EntityType<? extends ThrownSplashPotion> entityType, Level level) {
@@ -35,13 +38,30 @@ public class ThrownSplashPotion extends AbstractThrownPotion {
         return Items.SPLASH_POTION;
     }
 
+    @Override
+    protected double getDefaultGravity() {
+        return 0.05D;
+    }
+
+    @Override
+    public void shootFromRotation(Entity shooter, float xRot, float yRot, float pitchOffset, float velocity, float inaccuracy) {
+        // HCF Edit - Reduce initial velocity to prevent momentum inheritance from player movement
+        float reducedVelocity = velocity * 0.65F;
+
+        super.shootFromRotation(shooter, xRot, yRot, pitchOffset, reducedVelocity, inaccuracy);
+
+        // HCF Edit - Further reduce velocity to minimize player momentum transfer
+        Vec3 currentVel = this.getDeltaMovement();
+        this.setDeltaMovement(currentVel.scale(0.85));
+    }
+
     @Override
     public boolean onHitAsPotion(ServerLevel level, ItemStack stack, HitResult hitResult) { // Paper - More projectile API
         PotionContents potionContents = stack.getOrDefault(DataComponents.POTION_CONTENTS, PotionContents.EMPTY);
         float orDefault = stack.getOrDefault(DataComponents.POTION_DURATION_SCALE, 1.0F);
         Iterable<MobEffectInstance> allEffects = potionContents.getAllEffects();
         AABB aabb = this.getBoundingBox().move(hitResult.getLocation().subtract(this.position()));
-        AABB aabb1 = aabb.inflate(4.0, 2.0, 4.0);
+        AABB aabb1 = aabb.inflate(2.5, 2.0, 2.5); // HCF Edit - Update math lul
         List<LivingEntity> entitiesOfClass = this.level().getEntitiesOfClass(LivingEntity.class, aabb1);
         java.util.Map<org.bukkit.entity.LivingEntity, Double> affected = new java.util.HashMap<>(); // CraftBukkit
         float f = ProjectileUtil.computeMargin(this);
@@ -52,7 +72,7 @@ public class ThrownSplashPotion extends AbstractThrownPotion {
                 if (livingEntity.isAffectedByPotions()) {
                     double d = aabb.distanceToSqr(livingEntity.getBoundingBox().inflate(f));
                     if (d < 16.0) {
-                        double d1 = 1.0 - Math.sqrt(d) / 4.0; // Paper - diff on change, used when calling the splash event for water splash potions
+                        double d1 = 1.0 - (1.0 - Math.sqrt(d) / 4.0) * 0.75; // Paper - diff on change, used when calling the splash event for water splash potions. HCF Edit - Update math lul
                         // CraftBukkit start
                         affected.put(livingEntity.getBukkitLivingEntity(), d1);
                     }
@@ -73,10 +93,17 @@ public class ThrownSplashPotion extends AbstractThrownPotion {
                         // CraftBukkit end
                         for (MobEffectInstance mobEffectInstance : allEffects) {
                             Holder<MobEffect> effect = mobEffectInstance.getEffect();
+
+                            // HCF Edit - Boost healing potion effectiveness
+                            double effectiveIntensity = d1;
+                            if (effect.value().isInstantenous() && effect.value().isBeneficial()) { // idfk how to check for healing specifically, this is the fastest way I found lul
+                                effectiveIntensity = Math.min(d1 * 2.5, 1.5);
+                            }
+
                             if (effect.value().isInstantenous()) {
-                                effect.value().applyInstantenousEffect(level, this, this.getOwner(), livingEntity, mobEffectInstance.getAmplifier(), d1);
+                                effect.value().applyInstantenousEffect(level, this, this.getOwner(), livingEntity, mobEffectInstance.getAmplifier(), effectiveIntensity);
                             } else {
-                                int i = mobEffectInstance.mapDuration(i1 -> (int)(d1 * i1 * orDefault + 0.5));
+                                int i = mobEffectInstance.mapDuration(i1 -> (int)(d1 * i1 * orDefault * 0.85 + 0.5)); // HCF Edit - Reduce duration a bit more
                                 MobEffectInstance mobEffectInstance1 = new MobEffectInstance(
                                     effect, i, mobEffectInstance.getAmplifier(), mobEffectInstance.isAmbient(), mobEffectInstance.isVisible()
                                 );
